#!/usr/bin/env python3
"""Minimal `pass` replacement used as the Proton Drive CLI credentials store.

The Proton Drive CLI supports `PROTON_DRIVE_CREDENTIALS_STORE=pass` and then
calls exactly these commands:

    pass show <name>
    pass insert -f -m <name>     (secret on stdin)
    pass rm -f <name>

This shim implements them, storing the session JSON encrypted with
AES-256-GCM. The key is derived via HKDF-SHA256 from the DocNest master key,
so the Proton session (which contains the user's key password and refresh
token) is never written to disk in plaintext.

Environment:
    DOCNEST_MASTER_KEY_FILE      file containing the master key (required)
    DOCNEST_PROTON_SESSION_DIR   directory for the encrypted session (required)
"""

from __future__ import annotations

import base64
import fcntl
import json
import os
import sys
from pathlib import Path

from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
from cryptography.hazmat.primitives.kdf.hkdf import HKDF

ALLOWED_NAMES = {"ch.proton.drive/drive-sdk-cli/auth-session"}
HKDF_INFO = b"docnest/proton-session/v1"
MIN_MASTER_KEY_BYTES = 32
FORMAT_VERSION = 1


def fail(message: str, code: int = 1) -> None:
    sys.stderr.write(f"Error: {message}\n")
    sys.exit(code)


def require_env(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        fail(f"{name} is not set")
    return value  # type: ignore[return-value]


def derive_key() -> bytes:
    key_file = Path(require_env("DOCNEST_MASTER_KEY_FILE"))
    try:
        master = key_file.read_bytes().strip()
    except OSError as exc:
        fail(f"cannot read master key file: {exc.strerror}")
    if len(master) < MIN_MASTER_KEY_BYTES:
        fail("master key is too short")
    return HKDF(algorithm=hashes.SHA256(), length=32, salt=None, info=HKDF_INFO).derive(master)


def session_dir() -> Path:
    path = Path(require_env("DOCNEST_PROTON_SESSION_DIR"))
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def entry_path(directory: Path, name: str) -> Path:
    # Name is allow-listed, so a fixed file name avoids any path handling.
    return directory / "auth-session.enc"


class Lock:
    def __init__(self, directory: Path) -> None:
        self.path = directory / ".lock"

    def __enter__(self) -> None:
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)

    def __exit__(self, *exc: object) -> None:
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


def cmd_show(name: str) -> None:
    directory = session_dir()
    path = entry_path(directory, name)
    with Lock(directory):
        if not path.exists():
            fail(f"{name} is not in the password store.")
        blob = json.loads(path.read_text())
    if blob.get("v") != FORMAT_VERSION:
        fail("unsupported session file format")
    try:
        plaintext = AESGCM(derive_key()).decrypt(
            base64.b64decode(blob["nonce"]), base64.b64decode(blob["ct"]), name.encode()
        )
    except Exception:
        fail("cannot decrypt session (wrong master key or corrupted file)")
    sys.stdout.write(plaintext.decode())


def cmd_insert(name: str) -> None:
    secret = sys.stdin.buffer.read()
    if not secret:
        fail("empty secret")
    nonce = os.urandom(12)
    ct = AESGCM(derive_key()).encrypt(nonce, secret, name.encode())
    data = json.dumps(
        {"v": FORMAT_VERSION, "nonce": base64.b64encode(nonce).decode(), "ct": base64.b64encode(ct).decode()}
    ).encode()

    directory = session_dir()
    path = entry_path(directory, name)
    tmp = path.with_suffix(".tmp")
    with Lock(directory):
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, data)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, path)
        dir_fd = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)


def cmd_rm(name: str) -> None:
    directory = session_dir()
    path = entry_path(directory, name)
    with Lock(directory):
        if not path.exists():
            fail(f"{name} is not in the password store.")
        path.unlink()


def main(argv: list[str]) -> None:
    os.umask(0o077)
    if not argv:
        fail("usage: pass show|insert -f -m|rm -f <name>", 2)
    command, args = argv[0], [a for a in argv[1:] if not a.startswith("-")]
    if len(args) != 1:
        fail("exactly one entry name expected", 2)
    name = args[0]
    if name not in ALLOWED_NAMES:
        fail("entry not allowed", 2)

    if command == "show":
        cmd_show(name)
    elif command == "insert":
        cmd_insert(name)
    elif command == "rm":
        cmd_rm(name)
    else:
        fail(f"unsupported command: {command}", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
