# Public URL of your instance (as served by your HTTPS reverse proxy). Required.
DOCNEST_BASE_URL=https://docs.example.com

# Image version (a release like 0.1.0, or latest)
DOCNEST_VERSION=latest

# Where the container port is published (keep 127.0.0.1 when a proxy runs on the same host)
DOCNEST_BIND=127.0.0.1
DOCNEST_PORT=8000

# Storage: proton (default) or local (files stay in the data volume — for testing only)
DOCNEST_STORAGE_BACKEND=proton
DOCNEST_PROTON_ROOT=/my-files/DocNest

# OCR languages (Tesseract codes joined with +; the image ships deu and eng)
DOCNEST_OCR_LANGUAGES=deu+eng
# Initial Docling sender/title detector: layout, vlm, or hybrid (also configurable in Settings)
DOCNEST_DOCLING_FIELD_DETECTION=layout
DOCNEST_PROCESSING_CONCURRENCY=1

# AI analysis with a local vision-language model (start it with: docker compose --profile ai up -d).
# Choose and download models under Settings → System; DOCNEST_AI_MODEL only sets the initial choice.
# DOCNEST_OLLAMA_URL=http://ollama:11434
# Optional Bearer API key for an authenticated external server (or set it in Settings → System).
# DOCNEST_OLLAMA_API_KEY=
# DOCNEST_AI_MODEL=qwen3-vl:4b-instruct
# Context window (num_ctx) sent with each request. Unset: the Ollama server's own default
# (OLLAMA_CONTEXT_LENGTH) applies. A page image plus OCR text needs about 4500 tokens.
# DOCNEST_AI_CONTEXT_TOKENS=16384
# Seconds one request may take; a CPU-only server needs minutes per document.
# DOCNEST_AI_TIMEOUT_SECONDS=3600
DOCNEST_TIME_ZONE=Europe/Berlin

# Optional encrypted cache of recently viewed PDFs in MB (0 = off; files are fetched from Proton Drive each time)
DOCNEST_VIEW_CACHE_MB=0

# Database backups to Proton Drive (<DOCNEST_PROTON_ROOT>/backups): hours between backups (0 = off), backups kept
DOCNEST_BACKUP_INTERVAL_HOURS=24
DOCNEST_BACKUP_KEEP=14

# Troubleshooting: write everything that happens to daily log files (docs/operations.md#debug-log).
# Switch it off again afterwards. Files are kept DOCNEST_DEBUG_LOG_DAYS days.
DOCNEST_DEBUG_LOG=false

# Size of the in-memory work area (OCR of large scans needs more)
DOCNEST_TMP_SIZE=2g
DOCNEST_MAX_UPLOAD_MB=100
# Largest export that can be imported in the browser (Settings → System → Export & import)
DOCNEST_MAX_IMPORT_MB=50000
