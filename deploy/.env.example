# Public URL of your instance (as served by your HTTPS reverse proxy). Required.
DOCNEST_BASE_URL=https://docs.example.com

# Image version (a release like 0.1.0, or latest)
DOCNEST_VERSION=latest

# Where the container port is published (keep 127.0.0.1 when a proxy runs on the same host)
DOCNEST_BIND=127.0.0.1
DOCNEST_PORT=8000

# Storage: proton (default) or local (files stay in the data volume — for testing only)
DOCNEST_STORAGE_BACKEND=proton
DOCNEST_PROTON_ROOT=/my-files/DocNest

# OCR languages (Tesseract codes joined with +; the image ships deu and eng)
DOCNEST_OCR_LANGUAGES=deu+eng
# Initial Docling sender/title detector: layout, vlm, or hybrid (also configurable in Settings)
DOCNEST_DOCLING_FIELD_DETECTION=layout
DOCNEST_TIME_ZONE=Europe/Berlin

# Optional encrypted cache of recently viewed PDFs in MB (0 = off; files are fetched from Proton Drive each time)
DOCNEST_VIEW_CACHE_MB=0

# Size of the in-memory work area (OCR of large scans needs more)
DOCNEST_TMP_SIZE=2g
DOCNEST_MAX_UPLOAD_MB=100
